#!name=Locket Custom Edition
#!desc=Tùy chỉnh Locket Gold & Remote Config bởi Tấn Dũng.

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# 1. Trỏ tới script Remote Config mới của bạn
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/dung09-daries/locketgoldtd/refs/heads/main/Untitled-1.js, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache RevenueCat
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/usatalk/locket/main/deleteHeader.js, timeout=60

# 3. Kích hoạt gói Locket Gold
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/usatalk/locket/main/locket_sub.js, requires-body=true, max-size=-1, timeout=60
